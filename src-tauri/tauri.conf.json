{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dungeon Companion",
  "version": "0.1.2",
  "identifier": "it.dungeoncompanion.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Dungeon Companion",
        "width": 1200,
        "height": 800,
        "minWidth": 380,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost https://*.workers.dev https://github.com https://*.githubusercontent.com; frame-src 'self' blob:; object-src blob:; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQxMDQ0N0VENTA2NkExMTIKUldRU29XWlE3VWNFUVFRVHhTaVh4T3hFRzdEMnREODk1TkZWRmVZbjZLNDBkcGVTOTBRU0VPSEwK",
      "endpoints": [
        "https://github.com/OWNER/REPO/releases/latest/download/latest.json"
      ]
    }
  }
}
